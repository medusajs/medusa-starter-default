# =============================================================================
# kiji-games Medusa Backend - Umgebungsvariablen
#
# Kopieren nach `.env` und ausfüllen. `.env` wird NICHT committet.
# In Produktion (Coolify) werden die Werte in der Coolify-UI gesetzt.
# Mit NODE_ENV=production bricht der Start ab (fail fast), wenn Pflichtwerte
# fehlen: DATABASE_URL, REDIS_URL, *_CORS, JWT_SECRET, COOKIE_SECRET,
# MEDUSA_BACKEND_URL, STOREFRONT_URL, STRIPE_API_KEY, STRIPE_WEBHOOK_SECRET,
# RESEND_API_KEY, RESEND_FROM_EMAIL.
# =============================================================================

# --- Laufzeit ----------------------------------------------------------------
# development | production  (docker-compose.yml setzt development, das Image production)
# NODE_ENV=development

# shared (Server + Worker in einem Prozess, Default) | server | worker
# Für eine zweite Instanz als Hintergrund-Worker: dort `worker`, hier `server`.
MEDUSA_WORKER_MODE=shared
# true = Admin-Dashboard (/app) nicht ausliefern (Worker deaktivieren es automatisch)
DISABLE_MEDUSA_ADMIN=false

# Migrationen beim Container-Start (docker/entrypoint.sh, docker/dev-entrypoint.sh)
MEDUSA_RUN_MIGRATIONS=true
# Link-/Search-Sync bei db:migrate ohne interaktiven Prompt: safe | all | skip
# `all` nur EINMALIG setzen, wenn eine Link-Änderung nötig ist (z. B. erste
# Migration nach dem Upgrade 2.15 -> 2.21), danach wieder auf `safe`.
MEDUSA_MIGRATE_LINKS=safe
MEDUSA_MIGRATE_SEARCH=safe

# --- Öffentliche URLs ---------------------------------------------------------
# Öffentliche URL dieses Backends, ohne Slash am Ende (Prod: https://api.kiji-games.de).
# Basis für Upload-URLs (${MEDUSA_BACKEND_URL}/static/...) und Admin-Links in Mails.
# In Produktion Pflicht (Start bricht sonst ab).
MEDUSA_BACKEND_URL=http://localhost:9000
# Storefront-URL für Links in E-Mails (Prod: https://kiji-games.de). In Produktion Pflicht.
STOREFRONT_URL=http://localhost:4321

# --- CORS (kommagetrennt, ohne Slash am Ende) ----------------------------------
# Storefront-Dev läuft auf http://localhost:4321 (Astro).
# Prod: STORE_CORS=https://kiji-games.de
#       ADMIN_CORS=https://api.kiji-games.de
#       AUTH_CORS=https://kiji-games.de,https://api.kiji-games.de
STORE_CORS=http://localhost:4321
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:4321,http://localhost:5173,http://localhost:9000

# --- Secrets -------------------------------------------------------------------
# Zufällige Werte, z. B. `openssl rand -hex 32`. In Produktion Pflicht,
# mind. 32 Zeichen und nie "supersecret". JWT_SECRET signiert auch die
# Order- und E-Mail-Verifizierungs-Tokens (Wechsel macht offene Links ungültig).
JWT_SECRET=
COOKIE_SECRET=
# Schlüssel zur Verschlüsselung der MFA/TOTP-Secrets der Admin-User
# (`openssl rand -hex 32` -> 64 Zeichen). Nur nötig, wenn Admin-MFA genutzt wird.
# NICHT mehr ändern, sobald MFA aktiviert wurde - sonst sind bestehende Faktoren unbrauchbar.
AUTH_MFA_ENCRYPTION_KEY=

# --- Datenbank (PostgreSQL) -------------------------------------------------------
# docker compose (Dev):   postgres://postgres:postgres@postgres:5432/medusa-store
# lokal ohne Docker:      postgres://postgres:postgres@localhost:5432/medusa-store
# Sonderzeichen im Passwort URL-encoden.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa-store
# TLS zur DB: true (ohne Zertifikatsprüfung, z. B. Managed-DB mit Self-Signed-Cert)
# | verify (mit Prüfung) | leer/false (kein TLS, z. B. DB im selben Docker-Netz)
DATABASE_SSL=

# Nur für docker compose: Credentials des Postgres-Containers (müssen zu DATABASE_URL passen)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=medusa-store

# --- Redis ---------------------------------------------------------------------------
# Sessions, Event-Bus, Workflow-Engine, Locking, Caching. In Produktion Pflicht.
# Leer lassen = alles in-memory (nur für lokale Entwicklung ohne Redis).
# docker compose (Dev): redis://redis:6379   lokal ohne Docker: redis://localhost:6379
REDIS_URL=redis://redis:6379

# --- Datei-Uploads -----------------------------------------------------------------
# Ohne S3_BUCKET: lokaler Provider, Dateien in ./static (im Prod-Image /app/static
# -> als Volume persistieren!), ausgeliefert unter ${MEDUSA_BACKEND_URL}/static.
# Mit S3_BUCKET: S3-kompatibler Speicher (AWS S3, Cloudflare R2, MinIO).
S3_BUCKET=
# Öffentliche Basis-URL der Dateien, z. B. https://media.kiji-games.de
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2: auto | AWS: z. B. eu-central-1
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com (bei AWS leer lassen)
S3_ENDPOINT=
# optionaler Pfad-Präfix im Bucket, z. B. uploads/
S3_PREFIX=
# true für MinIO u. ä. (path-style URLs)
S3_FORCE_PATH_STYLE=false

# --- Stripe ------------------------------------------------------------------------
# Ohne STRIPE_API_KEY wird der Stripe-Provider nicht geladen (in Produktion Pflicht).
STRIPE_API_KEY=
# Signing-Secret des Webhook-Endpoints
# ${MEDUSA_BACKEND_URL}/hooks/payment/stripe_stripe  (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- Resend (E-Mail-Benachrichtigungen) -----------------------------------------------
# In Produktion Pflicht. Ohne RESEND_API_KEY (lokal/Tests) werden Mails nur
# geloggt (notification-local), nicht versendet.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Firmendaten (Footer der E-Mail-Templates) ------------------------------------------
COMPANY_ADDRESS_LINE=
COMPANY_CITY=

# --- Admin-Build (optional, Build-Zeit) ------------------------------------------------
# Basis-URL des Admin-SDKs in src/admin/lib/sdk.ts. Leer = gleiche Origin ("/"),
# richtig, solange der Admin vom Backend unter /app ausgeliefert wird.
# VITE_BACKEND_URL=
