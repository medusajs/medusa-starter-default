# Loaded by jest.config.js / medusa-config.ts when NODE_ENV=test, BEFORE `.env`
# (values here win over `.env`; real environment variables win over both).
# No real secrets in here - this file is committed.

# Postgres for @medusajs/test-utils (creates/drops temporary databases).
# Override in your shell or CI if your local Postgres differs.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Tests run with in-memory event bus / workflow engine / locking.
# Empty on purpose so a REDIS_URL from `.env` (docker host "redis") is not used.
REDIS_URL=

# Dummy values so the app boots in tests (no external calls are made).
JWT_SECRET=test-jwt-secret-not-for-production-use
COOKIE_SECRET=test-cookie-secret-not-for-production-use
STOREFRONT_URL=http://localhost:4321
MEDUSA_BACKEND_URL=http://localhost:9000
# Intentionally empty (overrides `.env`): Stripe provider is not registered and
# emails are only logged by the local notification provider in tests.
STRIPE_API_KEY=
RESEND_API_KEY=
